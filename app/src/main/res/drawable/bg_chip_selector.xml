<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/shs_cyan" />
            <corners android:radius="@dimen/shs_radius_chip" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/shs_cyan" />
            <corners android:radius="@dimen/shs_radius_chip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shs_surface_high" />
            <stroke android:width="1dp" android:color="@color/shs_stroke" />
            <corners android:radius="@dimen/shs_radius_chip" />
        </shape>
    </item>
</selector>
