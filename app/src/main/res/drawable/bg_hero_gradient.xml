<?xml version="1.0" encoding="utf-8"?>
<!-- Hero date card: soft navy→indigo gradient, large radius (SPEC: sparing gradients). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/shs_hero_end"
        android:startColor="@color/shs_hero_start"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/shs_stroke" />
    <corners android:radius="@dimen/shs_radius_card_large" />
</shape>
