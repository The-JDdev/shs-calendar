<?xml version="1.0" encoding="utf-8"?>
<!-- Designed placeholder screen for Phase 2/4 tabs (Prayer, Accounts) and
     TODO-Phase2 quick tools (Tasbih, Dua, Widgets...). Real layout, marked TODO. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/placeholder_toolbar"
        style="@style/SHS.TopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/app_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/shs_screen_padding">

        <com.google.android.material.card.MaterialCardView
            style="@style/SHS.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/shs_space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/shs_space_xl">

                <TextView
                    android:id="@+id/placeholder_title"
                    style="@style/SHS.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/placeholder_body"
                    style="@style/SHS.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/shs_space_md"
                    android:gravity="center"
                    android:textColor="@color/shs_text_secondary" />

                <TextView
                    android:id="@+id/placeholder_phase"
                    style="@style/SHS.Text.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/shs_space_lg"
                    android:text="@string/placeholder_phase2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
