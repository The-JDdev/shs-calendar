<?xml version="1.0" encoding="utf-8"?>
<!-- M2 prayer screen: location + next-prayer countdown card + full times list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shs_night"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/prayer_toolbar"
        style="@style/SHS.TopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/nav_prayer" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/shs_bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/shs_screen_padding">

            <!-- Location + method summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/prayer_location_label"
                    style="@style/SHS.Text.Accent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/prayer_no_location" />

                <TextView
                    android:id="@+id/prayer_method_summary"
                    style="@style/SHS.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Next prayer countdown -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SHS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/shs_space_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/shs_space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prayer_next"
                        android:textAppearance="@style/SHS.Text.Caption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/prayer_next_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/SHS.Text.Title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/prayer_next_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/SHS.Text.Subtitle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/prayer_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/SHS.Text.Body"
                        android:textColor="@color/shs_cyan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Empty state: no location yet -->
            <LinearLayout
                android:id="@+id/prayer_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/shs_space_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/shs_space_md"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/prayer_empty_location"
                    android:textAppearance="@style/SHS.Text.Body" />

                <Button
                    android:id="@+id/prayer_set_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/shs_space_xs"
                    android:text="@string/prayer_set_location" />
            </LinearLayout>

            <!-- Full times list (rows inflated from prayer_row.xml) -->
            <LinearLayout
                android:id="@+id/prayer_times_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/shs_space_xs"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
