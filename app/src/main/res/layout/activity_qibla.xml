<?xml version="1.0" encoding="utf-8"?>
<!-- M3 Qibla screen: computed bearing card (manual fallback), magnetometer
     compass dial (QiblaCompassView), sensor/calibration hints. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shs_night"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/qibla_toolbar"
        style="@style/SHS.TopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/tool_qibla" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/shs_bottom_nav_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/shs_screen_padding">

            <!-- Computed bearing: always visible = manual direction fallback -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SHS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/shs_space_md">

                    <TextView
                        android:id="@+id/qibla_location_label"
                        style="@style/SHS.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prayer_no_location" />

                    <TextView
                        android:id="@+id/qibla_bearing_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/SHS.Text.Title"
                        android:textColor="@color/shs_cyan"
                        android:textStyle="bold"
                        tools:text="277.6\u00B0" />

                    <TextView
                        android:id="@+id/qibla_distance"
                        style="@style/SHS.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Magnetometer dial: needle rotates to the Qibla -->
            <com.shs.calendar.ui.qibla.QiblaCompassView
                android:id="@+id/qibla_compass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/shs_space_md"
                android:minHeight="260dp" />

            <TextView
                android:id="@+id/qibla_calibration_hint"
                style="@style/SHS.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/qibla_calibrate"
                android:visibility="gone" />

            <TextView
                android:id="@+id/qibla_no_sensor_hint"
                style="@style/SHS.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/qibla_no_sensor"
                android:visibility="gone" />

            <TextView
                android:id="@+id/qibla_empty_hint"
                style="@style/SHS.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/qibla_location_missing"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
