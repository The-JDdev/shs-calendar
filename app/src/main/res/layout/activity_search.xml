<?xml version="1.0" encoding="utf-8"?>
<!-- Unified search: query field, grouped results list, empty state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:title="@string/search_title" />

    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/shs_space_md"
        android:layout_marginEnd="@dimen/shs_space_md"
        android:autofillHints=""
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="48dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/shs_space_md"
            android:paddingTop="@dimen/shs_space_sm"
            android:paddingEnd="@dimen/shs_space_md" />

        <TextView
            android:id="@+id/search_empty"
            style="@style/SHS.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/shs_space_lg"
            android:text="@string/search_empty"
            android:textColor="@color/shs_text_muted"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
