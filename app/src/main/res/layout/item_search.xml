<?xml version="1.0" encoding="utf-8"?>
<!-- One search hit: kind badge, title, subtitle, and the time sort key. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_compact"
    android:layout_marginBottom="@dimen/shs_space_sm"
    android:orientation="vertical"
    android:padding="@dimen/shs_space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/search_row_kind"
            style="@style/SHS.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/shs_space_sm"
            android:textColor="@color/shs_cyan" />

        <TextView
            android:id="@+id/search_row_title"
            style="@style/SHS.Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/shs_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/search_row_subtitle"
        style="@style/SHS.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shs_space_xs"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/shs_text_muted"
        android:visibility="gone" />
</LinearLayout>
