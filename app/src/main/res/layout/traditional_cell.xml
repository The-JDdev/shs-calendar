<?xml version="1.0" encoding="utf-8"?>
<!-- M4: one cell of the Traditional Bangla printed calendar.
     White cell; large green Bengali numeral; blue Gregorian + Hijri numbers;
     optional yellow (Bengali sub-strip) and cyan (Hijri sub-strip) rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@color/shs_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="1dp"
    android:paddingEnd="1dp">

    <!-- Large Bengali day numeral, printed green. -->
    <TextView
        android:id="@+id/trad_cell_bengali_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/shs_bengali_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Blue Gregorian day + Bangla Gregorian date. -->
    <TextView
        android:id="@+id/trad_cell_gregorian"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/shs_hijri_blue"
        android:textSize="10sp" />

    <!-- Yellow sub-strip: Bengali month name abbreviation. -->
    <TextView
        android:id="@+id/trad_cell_bengali_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/shs_amber"
        android:gravity="center"
        android:textColor="@color/shs_night_deep"
        android:textSize="8sp"
        android:visibility="gone" />

    <!-- Cyan sub-strip: Hijri day + month. -->
    <TextView
        android:id="@+id/trad_cell_hijri_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/shs_cyan"
        android:gravity="center"
        android:textColor="@color/shs_night_deep"
        android:textSize="8sp"
        android:visibility="gone" />

    <!-- Red holiday mark; empty for non-holidays. -->
    <TextView
        android:id="@+id/trad_cell_holiday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/shs_danger"
        android:textSize="8sp"
        android:visibility="gone" />
</LinearLayout>
