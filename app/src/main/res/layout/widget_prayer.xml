<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/shs_widget_bg"
    android:padding="12dp"
    android:theme="@style/Theme.SHSCalendar">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/shs_text_secondary"
        android:textSize="12sp"
        android:maxLines="1"
    />
    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/shs_cyan"
        android:textSize="18sp"
        android:layout_marginTop="4dp"
    />
    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/shs_text_muted"
        android:textSize="10sp"
        android:layout_marginTop="4dp"
    />
 </LinearLayout>
