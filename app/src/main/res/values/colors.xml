<?xml version="1.0" encoding="utf-8"?>
<!-- SHS Calendar design system — LIGHT palette (the default slot).

     M10: the deep-navy identity now lives in values-night/colors.xml. The
     default values/ slot is light, which is the standard Android inversion and
     what makes Theme.LIGHT stop being a cosmetic radio button.

     Every text/semantic pair below is COMPUTED to clear WCAG AA 4.5:1, not
     chosen by eye — verified by LightPaletteTest, which parses this file and
     measures each pair. A colour that drifts below AA fails the build. -->
<resources>
    <!-- Core surfaces -->
    <color name="shs_night">#F7F9FF</color>          <!-- app background -->
    <color name="shs_night_deep">#EEF2FB</color>     <!-- sunken / edge -->
    <color name="shs_surface">#FFFFFF</color>        <!-- card surface -->
    <color name="shs_surface_high">#EEF2FB</color>   <!-- raised surface / input -->
    <color name="shs_surface_low">#E4EAF6</color>    <!-- sunken surface -->
    <color name="shs_stroke">#C3CCE0</color>         <!-- hairline stroke -->

    <!-- Accents: dark enough to read as text on the light background (4.65:1+),
         and to carry white button labels (4.90:1+). Both directions asserted. -->
    <color name="shs_cyan">#067B97</color>
    <color name="shs_teal">#0F766E</color>
    <!-- Containers sit UNDER shs_text_primary in the light palette, so the
         _deep roles are the pale tints and the on-container is the dark text.
         shs_cyan_deep is an accent here, not a container: M10's night theme
         uses it as a container, and the overlay styles reference the same name
         in both palettes, so it must stay a readable accent in light. -->
    <color name="shs_cyan_deep">#CDEDF5</color>
    <color name="shs_teal_deep">#CFF3EE</color>
    <color name="shs_indigo_deep">#E0E1FC</color>
    <color name="shs_purple_deep">#EDE4FE</color>
    <color name="shs_magenta_deep">#FBE0EC</color>
    <color name="shs_amber_deep">#FCF0D2</color>

    <color name="shs_indigo">#4F46E5</color>
    <color name="shs_purple">#7C3AED</color>
    <color name="shs_magenta">#BE185D</color>
    <color name="shs_orange">#C2410C</color>
    <color name="shs_amber">#A16207</color>

    <!-- Text: primary 17.87:1, secondary 8.00:1, muted 5.54:1 on shs_night. -->
    <color name="shs_text_primary">#0B1026</color>
    <color name="shs_text_secondary">#414C70</color>
    <color name="shs_text_muted">#5A6486</color>
    <color name="shs_text_on_accent">#FFFFFF</color>

    <!-- Semantic -->
    <color name="shs_success">#047857</color>
    <color name="shs_danger">#BE123C</color>
    <color name="shs_warning">#A16207</color>

    <!-- Bengali day cell accent (deep green printed-calendar look) -->
    <color name="shs_bengali_green">#0F7B4F</color>
    <color name="shs_hijri_blue">#1D4ED8</color>

    <!-- Gradient endpoints -->
    <color name="shs_gradient_start">#FFFFFF</color>
    <color name="shs_gradient_end">#EEF2FB</color>
    <color name="shs_hero_start">#FFFFFF</color>
    <color name="shs_hero_end">#EEF2FB</color>

    <!-- Icon scrims -->
    <color name="shs_scrim">#99000000</color>
    <color name="shs_transparent">#00000000</color>

    <!-- Bottom navigation -->
    <color name="shs_nav_bg">#FFFFFF</color>
    <color name="shs_nav_inactive">#5A6486</color>

    <!-- Focus / ripple -->
    <color name="shs_ripple">#33067B97</color>
    <!-- M10 AMOLED: true black so an OLED panel lights only the pixels it must. -->
    <color name="shs_night_amoled">#000000</color>
    <color name="shs_surface_amoled">#0A0A0A</color>
</resources>
