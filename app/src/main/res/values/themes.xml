<?xml version="1.0" encoding="utf-8"?>
<!-- SHS Calendar premium dark theme: deep navy, cyan/teal accents, Material Components. -->
<resources>

    <style name="Theme.SHSCalendar" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/shs_cyan</item>
        <item name="colorOnPrimary">@color/shs_text_on_accent</item>
        <item name="colorPrimaryContainer">@color/shs_cyan_deep</item>
        <item name="colorOnPrimaryContainer">@color/shs_text_primary</item>

        <item name="colorSecondary">@color/shs_teal</item>
        <item name="colorOnSecondary">@color/shs_text_on_accent</item>
        <item name="colorSecondaryContainer">@color/shs_teal_deep</item>
        <item name="colorOnSecondaryContainer">@color/shs_text_primary</item>

        <item name="colorTertiary">@color/shs_indigo</item>
        <item name="colorOnTertiary">@color/shs_text_on_accent</item>

        <item name="colorError">@color/shs_danger</item>
        <item name="colorOnError">@color/shs_text_on_accent</item>

        <item name="android:colorBackground">@color/shs_night</item>
        <item name="colorSurface">@color/shs_surface</item>
        <item name="colorSurfaceVariant">@color/shs_surface_high</item>
        <item name="colorOnSurface">@color/shs_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/shs_text_secondary</item>
        <item name="colorOutline">@color/shs_stroke</item>

        <item name="android:statusBarColor">@color/shs_night</item>
        <item name="android:navigationBarColor">@color/shs_nav_bg</item>
        <item name="android:windowBackground">@color/shs_night</item>
        <item name="android:textColorPrimary">@color/shs_text_primary</item>
        <item name="android:textColorSecondary">@color/shs_text_secondary</item>
        <item name="android:textColorHint">@color/shs_text_muted</item>

        <item name="materialAlertDialogTheme">@style/Theme.SHSCalendar.Dialog</item>
    </style>

    <style name="Theme.SHSCalendar.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/shs_surface_high</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.SHSCalendar.Large</item>
    </style>

    <style name="ShapeAppearance.SHSCalendar.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/shs_radius_card</item>
    </style>

    <!--
      M10 accent overlays.

      Each overlay re-tints only the accent roles, leaving surfaces and text
      untouched, so switching accent cannot change contrast. The _deep
      container colours are computed (not eyeballed) to clear WCAG AA 4.5:1
      against shs_text_primary; ContrastTest asserts every pair below so a
      later palette tweak cannot quietly push one under AA.

      The project ships a single dark theme, so no overlay switches light and
      dark. See AccentOverlay for why these must be style resources.
    -->
    <style name="ThemeOverlay.SHSCalendar.Accent.Teal" parent="">
        <item name="colorPrimary">@color/shs_teal</item>
        <item name="colorPrimaryContainer">@color/shs_teal_deep</item>
        <item name="colorSecondary">@color/shs_teal</item>
        <item name="colorSecondaryContainer">@color/shs_teal_deep</item>
    </style>

    <style name="ThemeOverlay.SHSCalendar.Accent.Indigo" parent="">
        <item name="colorPrimary">@color/shs_indigo</item>
        <item name="colorPrimaryContainer">@color/shs_indigo_deep</item>
        <item name="colorSecondary">@color/shs_indigo</item>
        <item name="colorSecondaryContainer">@color/shs_indigo_deep</item>
        <item name="colorTertiary">@color/shs_indigo</item>
    </style>

    <style name="ThemeOverlay.SHSCalendar.Accent.Purple" parent="">
        <item name="colorPrimary">@color/shs_purple</item>
        <item name="colorPrimaryContainer">@color/shs_purple_deep</item>
        <item name="colorSecondary">@color/shs_purple</item>
        <item name="colorSecondaryContainer">@color/shs_purple_deep</item>
        <item name="colorTertiary">@color/shs_purple</item>
    </style>

    <style name="ThemeOverlay.SHSCalendar.Accent.Magenta" parent="">
        <item name="colorPrimary">@color/shs_magenta</item>
        <item name="colorPrimaryContainer">@color/shs_magenta_deep</item>
        <item name="colorSecondary">@color/shs_magenta</item>
        <item name="colorSecondaryContainer">@color/shs_magenta_deep</item>
        <item name="colorTertiary">@color/shs_magenta</item>
    </style>

    <style name="ThemeOverlay.SHSCalendar.Accent.Amber" parent="">
        <item name="colorPrimary">@color/shs_amber</item>
        <item name="colorPrimaryContainer">@color/shs_amber_deep</item>
        <item name="colorSecondary">@color/shs_amber</item>
        <item name="colorSecondaryContainer">@color/shs_amber_deep</item>
        <item name="colorTertiary">@color/shs_amber</item>
    </style>

</resources>
